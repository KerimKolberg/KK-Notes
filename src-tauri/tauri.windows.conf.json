{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "KK-Notes",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KK-Notes",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "maximized": true,
        "visible": false,
        "create": false,
        "decorations": true,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-gpu-rasterization --enable-zero-copy"
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
