{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KK-Notes",
  "version": "0.1.0",
  "identifier": "com.notex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KK-Notes",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "maximized": true,
        "decorations": true,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-gpu-rasterization --enable-zero-copy"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost data: blob:; worker-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Productivity",
    "shortDescription": "Pen-first multi-page notes",
    "longDescription": "Low-latency inking, STEM shape tools, PDF import and annotation, vector PDF export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "notex"
        ],
        "name": "KK-Notes Document",
        "description": "KK-Notes inking document",
        "mimeType": "application/x-notex+json",
        "role": "Editor"
      },
      {
        "ext": [
          "goodnotes"
        ],
        "name": "GoodNotes Notebook",
        "description": "GoodNotes notebook, imported as pen strokes",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 26,
      "versionCode": 1
    }
  },
  "plugins": {}
}
