<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything that does not need a window: the stroke model, the outline algorithm,
    hit-testing, history, the pen-button state machine and the page camera. Kept free of
    WinUI so it is tested with plain xUnit (KKNotes.Core.Tests).
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KKNotes.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KKNotes.Core.Tests" />
  </ItemGroup>

</Project>
