<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KKNotes.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="KK-Notes (native prototype)">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnRedoAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" Invoked="OnRedoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="OnFitAccelerator" />
            <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- The toolbar. Kept off the drawing area rather than floating over it. -->
        <Grid Grid.Row="0" Padding="8,6" ColumnSpacing="16"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="BallpointButton" Click="OnToolClick" Tag="ballpoint" ToolTipService.ToolTip="Ballpoint: even width, as the current app's default pen">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" />
                        <TextBlock Text="Ballpoint" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="FountainButton" Click="OnToolClick" Tag="fountain" ToolTipService.ToolTip="Fountain pen: follows pressure and tilt">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEDFB;" FontSize="16" />
                        <TextBlock Text="Fountain" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="HighlighterButton" Click="OnToolClick" Tag="highlighter" ToolTipService.ToolTip="Highlighter">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7E6;" FontSize="16" />
                        <TextBlock Text="Highlighter" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="EraserButton" Click="OnToolClick" Tag="eraser" ToolTipService.ToolTip="Stroke eraser: removes whole strokes it crosses">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE75C;" FontSize="16" />
                        <TextBlock Text="Eraser" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel x:Name="Swatches" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
            <StackPanel x:Name="Widths" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                <Button Click="OnUndoClick" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                </Button>
                <Button Click="OnRedoClick" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                    <FontIcon Glyph="&#xE7A6;" FontSize="16" />
                </Button>
                <Button Click="OnClearClick" ToolTipService.ToolTip="Clear the page (undoable)">
                    <FontIcon Glyph="&#xE74D;" FontSize="16" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                <ComboBox x:Name="PredictionBox" SelectionChanged="OnPredictionChanged" MinWidth="170"
                          ToolTipService.ToolTip="How far ahead Windows predicts the pen. The predicted bit is drawn but never kept." />
                <ComboBox x:Name="PresentBox" SelectionChanged="OnPresentChanged" MinWidth="150"
                          ToolTipService.ToolTip="Hand each frame to the compositor at once, or wait for the screen's refresh first">
                    <x:String>Present at once</x:String>
                    <x:String>Present on v-sync</x:String>
                </ComboBox>
                <ToggleButton x:Name="StatsButton" IsChecked="True" Click="OnStatsClick" ToolTipService.ToolTip="Show the measurements">
                    <FontIcon Glyph="&#xE9D9;" FontSize="16" />
                </ToggleButton>
                <Button Click="OnFitClick" ToolTipService.ToolTip="Fit the page to the width (Ctrl+0)">
                    <FontIcon Glyph="&#xE9A6;" FontSize="16" />
                </Button>
                <Button Click="OnFullScreenClick" ToolTipService.ToolTip="Full screen (F11)">
                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatsText" Grid.Row="1" Margin="12,3" FontSize="12"
                   FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <canvas:CanvasSwapChainPanel x:Name="InkPanel" Grid.Row="2" />
    </Grid>
</Window>
